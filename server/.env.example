JWT_SECRET=your_jwt_secret_here

# MongoDB
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Gemini AI (primary)
GEMINI_API_KEY=your_gemini_api_key
USE_GEMINI=true

# OpenRouter (fallback)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_REFERRER=http://localhost:3000

# ImageKit
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# External APIs (optional)
CRICKET_API_KEY=your_cricapi_key
FOOTBALL_API_KEY=your_football_api_key

# Server
PORT=3000

# Comma separated list of allowed frontend origins (optional, default: all)
CORS_ORIGIN=http://localhost:5173

# Only for local testing against a mock Gemini server (optional)
# GEMINI_BASE_URL=http://localhost:4010

# Optional: override the Gemini text-to-speech model used for the premium voices
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: override the Gemini model chains (comma separated, tried in order). Google retires model ids often.
# GEMINI_MODELS_FLASH=gemini-3.5-flash,gemini-flash-latest
# GEMINI_MODELS_LITE=gemini-3.5-flash-lite,gemini-flash-lite-latest
# GEMINI_MODELS_PRO=gemini-3.1-pro-preview,gemini-pro-latest
